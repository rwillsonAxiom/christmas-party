# F5/deno task dev set up their own local PostgreSQL automatically.
# These connection settings are for deno task start and explicit database tools.
# Database credentials and passwords must never enter public/.
APP_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/credit_cards
STAFF_PASSWORD=
PUBLIC_URL=http://localhost:8000
# For Supabase use the transaction-pooler connection string (port 6543).
# Optional local-development overrides:
# DEV_DATABASE_PORT=15433
# DEV_PUBLIC_URL=http://192.168.1.20:8000
# POSTGRES_BIN=C:/Program Files/PostgreSQL/17/bin
